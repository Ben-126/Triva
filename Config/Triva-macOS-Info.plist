<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist PARTIEL du Mac (chantier 2.2, M7). Xcode le FUSIONNE avec le plist généré
  (GENERATE_INFOPLIST_FILE = YES) : toutes les clés INFOPLIST_KEY_* du projet restent actives.
  Ce fichier vit hors du dossier synchronisé `Triva/` : dedans, il serait copié comme ressource
  et le build échouerait. Branché par `INFOPLIST_FILE[sdk=macosx*]` : iPhone et iPad ne le lisent pas.
-->
<plist version="1.0">
<dict>
	<!-- Service du menu « Services » : clic droit sur un texte sélectionné > Services > Rechercher avec Triva.
	     Le texte est remis à `TrivaServicesProvider.searchWithTriva(_:userData:error:)`. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Rechercher avec Triva</string>
			</dict>
			<key>NSMessage</key>
			<string>searchWithTriva</string>
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
