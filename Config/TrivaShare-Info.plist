<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist PARTIEL de l'extension de partage (chantier 2.1, S1), iPhone et iPad seulement.
  Fusionné avec le plist généré (GENERATE_INFOPLIST_FILE = YES). Hors du dossier synchronisé `TrivaShare/`.
  Le nom affiché dans la feuille de partage vient de INFOPLIST_KEY_CFBundleDisplayName (projet).
  Règles d'activation de la spec §4.6 : texte, une URL web, une page web (la page passe par le script
  de prétraitement Safari ShareSafariPreprocessor.js, qui renvoie son titre et son adresse).
  Mission E (décision de Ben du 24/11) : un fichier ET une image à la fois (PDF et images). La règle « fichier »
  du dictionnaire n'a pas de variante « PDF seulement » : Triva apparaît donc aussi pour un autre type de fichier,
  que la feuille refuse alors clairement (« Triva ne lit pas ce type de fichier. »). Une règle à prédicat
  (SUBQUERY … UTI-CONFORMS-TO) serait plus précise mais ne se vérifie pas sans appareil : si elle échoue, TOUT le
  partage (texte, page) disparaît en silence ; choix prudent, réversible.
-->
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>NSExtensionActivationRule</key>
			<dict>
				<key>NSExtensionActivationSupportsText</key>
				<true/>
				<key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
				<integer>1</integer>
				<key>NSExtensionActivationSupportsWebPageWithMaxCount</key>
				<integer>1</integer>
				<key>NSExtensionActivationSupportsFileWithMaxCount</key>
				<integer>1</integer>
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>1</integer>
			</dict>
			<key>NSExtensionJavaScriptPreprocessingFile</key>
			<string>ShareSafariPreprocessor</string>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
	</dict>
</dict>
</plist>
